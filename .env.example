# Copy to .env and fill in. Never commit .env.
# All values can also be passed as CLI flags (run --help); flags override .env.

# Base URL of your Immich server, including any port (no trailing slash).
IMMICH_URL=http://localhost:2283

# The user who KEEPS the surviving copies ("primary").
PRIMARY_EMAIL=
PRIMARY_API_KEY=

# Every user whose duplicates should be trashed ("secondaries") — any number.
# Emails and keys are comma-separated lists, paired by position:
SECONDARY_EMAILS=bob@example.com,carol@example.com
SECONDARY_API_KEYS=bobs-key,carols-key

# Immich API keys (Account Settings -> API Keys). What this tool does with them:
#   primary key:   lists their library, joins their copy to albums they own,
#                  optionally merges favorites/descriptions. NEVER deletes anything.
#   secondary keys: list that user's library, add the keeper to albums that user
#                  owns, and move THAT user's own duplicates to trash (restorable).
#                  Never touch anyone else's assets.
# No admin account is required. The tool never hard-deletes and never changes
# server settings.

# PREREQUISITE: enable partner sharing between the primary and EVERY secondary
# user, in both directions (star topology) — otherwise cross-user album
# transfers are rejected. See the README ("How media stays accessible").
