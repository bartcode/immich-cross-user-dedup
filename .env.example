# Copy to .env and fill in. Never commit .env.
# All values can also be passed as CLI flags (run --help); flags override .env.

# Base URL of your Immich server, including any port (no trailing slash).
IMMICH_URL=http://localhost:2283

# The user who KEEPS the surviving copies ("primary").
PRIMARY_EMAIL=
PRIMARY_API_KEY=

# Every user whose duplicates should be trashed ("secondaries") — any number.
# Emails and keys are comma-separated lists, paired by position:
SECONDARY_EMAILS=bob@example.com,carol@example.com
SECONDARY_API_KEYS=bobs-key,carols-key

# Immich API keys (Account Settings -> API Keys), with exactly these scopes:
#   primary key:    user.read, partner.read, asset.read, asset.view,
#                   asset.statistics, album.read, albumAsset.create,
#                   albumAsset.delete
#                   (+ asset.update only if you use --merge-metadata)
#   secondary keys: the same scopes plus albumUser.create, albumUser.delete and
#                   asset.delete (trashes that user's own copies, restores on
#                   undo, and shares affected albums with the primary as editor
#                   when partner sharing is off)
# Or simply select the "all" scope. Read scopes are verified by pre-flight.
# Partner sharing is OPTIONAL: without it, affected albums are shared with the
# primary as editor during apply and revoked on undo.

# OPTIONAL: partner sharing (primary shares with each secondary) enables direct
# album transfers and gives the secondaries timeline visibility of the primary's
# library — see the README ("How album access works") for the trade-off.
