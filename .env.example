# Copy to .env and fill in. Never commit .env.
# All values can also be passed as CLI flags (run --help); flags override .env.

# Base URL of your Immich server, including any port (no trailing slash).
IMMICH_URL=http://localhost:2283

# The user who KEEPS the surviving copies ("primary"), and the user whose
# duplicates get trashed ("secondary"). Identify them by email.
PRIMARY_EMAIL=
SECONDARY_EMAIL=

# Immich API keys for both users (Immich web app: Account Settings -> API Keys).
PRIMARY_API_KEY=
SECONDARY_API_KEY=

# PREREQUISITE: enable partner sharing between the two users (both directions),
# otherwise adding one user's assets to the other user's albums is rejected.
# See the README ("How media stays accessible to both users").
